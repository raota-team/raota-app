{
  "expo": {
    "name": "RAOTA",
    "slug": "raota",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "raota",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.raota.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "내 주변 라멘집과 거리를 보여드리기 위해 위치를 사용합니다.",
        "NSCameraUsageDescription": "라멘 기록에 사진을 남기기 위해 카메라를 사용합니다.",
        "NSPhotoLibraryUsageDescription": "라멘 기록과 프로필에 사진을 추가하기 위해 사진 보관함을 사용합니다.",
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
              }
            ]
          }
        }
      }
    },
    "android": {
      "package": "com.raota.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/logo.png",
        "monochromeImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "내 주변 라멘집과 거리를 보여드리기 위해 위치를 사용합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "라멘 기록과 프로필에 사진을 추가하기 위해 사진 보관함을 사용합니다.",
          "cameraPermission": "라멘 기록에 사진을 남기기 위해 카메라를 사용합니다.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E60000",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF8EA"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "./plugins/withIosSceneLifecycle"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
