{
  "expo": {
    "name": "RAOTA",
    "slug": "raota",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "raota",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.raota.app",
      "buildNumber": "8",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "내 주변 라멘집과 거리를 보여드리기 위해 위치를 사용합니다.",
        "NSCameraUsageDescription": "라멘 기록에 사진을 남기기 위해 카메라를 사용합니다.",
        "NSPhotoLibraryUsageDescription": "라멘 기록과 프로필에 사진을 추가하기 위해 사진 보관함을 사용합니다.",
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
              }
            ]
          }
        },
        "CFBundleDevelopmentRegion": "ko"
      }
    },
    "android": {
      "package": "com.raota.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/logo.png",
        "monochromeImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "ko",
              "en",
              "zh-Hans",
              "ja"
            ],
            "android": [
              "ko",
              "en",
              "zh-Hans",
              "ja"
            ]
          },
          "supportsRTL": false,
          "allowDynamicLocaleChangesAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "내 주변 라멘집과 거리를 보여드리기 위해 위치를 사용합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "라멘 기록과 프로필에 사진을 추가하기 위해 사진 보관함을 사용합니다.",
          "cameraPermission": "라멘 기록에 사진을 남기기 위해 카메라를 사용합니다.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E60000",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-dark.png",
            "backgroundColor": "#121211"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/Pretendard-Regular.otf",
              "./assets/fonts/Pretendard-Medium.otf",
              "./assets/fonts/Pretendard-SemiBold.otf",
              "./assets/fonts/Pretendard-Bold.otf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Pretendard",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Pretendard-Regular.otf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Pretendard-Medium.otf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Pretendard-SemiBold.otf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Pretendard-Bold.otf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-image",
      "expo-web-browser",
      "./plugins/withIosSceneLifecycle",
      [
        "@mj-studio/react-native-naver-map",
        {
          "client_id": "u84o9e15rb"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://repository.map.naver.com/archive/maven",
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "ko": "./locales/ko.json",
      "en": "./locales/en.json",
      "zh-Hans": "./locales/zh-Hans.json",
      "ja": "./locales/ja.json"
    }
  }
}
