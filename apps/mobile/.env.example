# 이 파일을 .env로 복사해 값을 채운다(.env는 커밋하지 않는다). 기본 빌드는 mock이다.
# 서버 주소는 저장소에 적지 않는다. 주소가 없으면 아래 remote 설정은 무시되고 mock으로 돈다.
EXPO_PUBLIC_API_BASE_URL=https://<API 서버 주소>/api/v2
# 서버에 연결할 도메인(쉼표로 구분, 비우거나 all이면 전부)
# - auth: 소셜 로그인·온보딩·약관 동의·세션 복원·로그아웃·탈퇴
# - member: 내 정보 수정·닉네임 확인 / ramenLogs: 내 기록·기록 쓰기(사진)·수정·삭제 / recommendations: AI 추천
#   (이 셋은 회원 토큰이 필요해서 auth를 같이 켜야 서버로 간다. auth 없이 적으면 로컬로 돈다)
# - shops: 매장·지도·오늘의 큐레이션, lounge: 라운지 읽기 (비회원도 읽는다)
#   찜(shops)·공감·댓글·신고·숨기기(lounge)는 auth도 켜져 있을 때만 서버로 간다
EXPO_PUBLIC_API_MODE=remote
EXPO_PUBLIC_API_REMOTE_DOMAINS=auth,member,shops,ramenLogs,lounge,recommendations

# 소셜 로그인(auth가 remote일 때 쓴다). 값을 바꾸면 npx expo prebuild로 네이티브 설정(URL 스킴)을 다시 만든다.
# 비워 두면 그 제공자의 네이티브 설정을 넣지 않고 로그인 화면에서 버튼을 숨긴다.
# 카카오 개발자 콘솔 > 앱 키 > 네이티브 앱 키
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=<카카오 네이티브 앱 키>
# Google Cloud 콘솔 > OAuth 클라이언트. iOS 클라이언트 ID와, 서버가 aud로 확인하는 웹 클라이언트 ID
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<숫자-문자열>.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<숫자-문자열>.apps.googleusercontent.com

# 앱 이용 통계(PostHog). 비워 두면 이벤트를 보내지 않는다. PostHog 프로젝트 설정 > Project API key
# EU 프로젝트면 HOST를 https://eu.i.posthog.com 으로 바꾸고 개인정보처리방침의 이전 국가도 바꾼다.
EXPO_PUBLIC_POSTHOG_KEY=<phc_로 시작하는 프로젝트 키>
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# 기능 스위치. true일 때만 켠다(비우거나 다른 값이면 꺼짐). 출시 빌드는 비워 둔다.
# 취향 리포트(/taste, 월간 리포트): 꺼지면 마이 탭 입구·기록 완료 버튼·딥링크·월간 리포트 알림이 사라진다
EXPO_PUBLIC_FEATURE_TASTE_REPORT=
