+
+- (void)raotaCameraStep:(CADisplayLink *)link{
+    if (!_view || !_raotaCameraFrom || !_raotaCameraTo) {
+        [self raotaStopCameraAnimation];
+        return;
+    }
+    double t = MIN(1.0, (CACurrentMediaTime() - _raotaCameraStart) / _raotaCameraDuration);
+    double e = 1.0 - pow(1.0 - t, 3.0);
+    CLLocationCoordinate2D a = _raotaCameraFrom.centerCoordinate;
+    CLLocationCoordinate2D b = _raotaCameraTo.centerCoordinate;
+    MKMapCamera *step = [_raotaCameraTo copy];
+    step.centerCoordinate = CLLocationCoordinate2DMake(a.latitude + (b.latitude - a.latitude) * e,
+                                                       a.longitude + (b.longitude - a.longitude) * e);
+    double fromDistance = MAX(_raotaCameraFrom.centerCoordinateDistance, 1.0);
+    double toDistance = MAX(_raotaCameraTo.centerCoordinateDistance, 1.0);
+    step.centerCoordinateDistance = fromDistance * pow(toDistance / fromDistance, e);
+    _view.camera = t >= 1.0 ? _raotaCameraTo : step;
+    if (t >= 1.0) {
+        [self raotaStopCameraAnimation];
+    }
+}
